# Preparation only; never source this into production without separate approval.
SOLOFORGE_CLOUDFLARE_LIVE_ENABLED=false
# Required server-only AEAD wrapping keyring, JSON {key-id:base64-32-byte-key}.
# Supply through the existing secret manager; never put provider API tokens here.
CLOUDFLARE_BYOP_KEYRING_JSON=
CLOUDFLARE_BYOP_ACTIVE_KEY_ID=
# Enabling the flag alone does not authorize execution. Required separately:
# Owner V2; applied/rehearsed SQL; independently verified owner-bound credential;
# provisioned Neurons ledger; trusted fresh all-in quote via get_cloudflare_pricing;
# explicit bounded consent; atomic CALL_STARTED. Default pricing fails closed.
# No inferred free quota, provider charge cap, upstream revocation or settlement.

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SoloForge Offline QA Evidence Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "job_id",
    "stage",
    "revision_id",
    "input_sha256",
    "output_sha256",
    "artifact_ref",
    "validator_version",
    "result",
    "reviewer_id",
    "reviewed_at",
    "dependency_evidence_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "CONTENT",
        "GROUNDING",
        "VISUAL",
        "AUDIO",
        "VIDEO_RENDER",
        "FINAL_QA"
      ]
    },
    "revision_id": {
      "type": "string",
      "minLength": 1
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "output_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact_ref": {
      "type": "string",
      "minLength": 1
    },
    "validator_version": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "REVIEW_REQUIRED",
        "BLOCKED",
        "STALE"
      ]
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "dependency_evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
